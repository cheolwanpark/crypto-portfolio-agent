# =============================================================================
# LowerBound - Environment Configuration
# =============================================================================
# Setup:
#   cp .env.example .env
#   # Edit .env and add your Claude token
#   docker compose up
#
# Scale workers: docker compose up --scale agent-worker=3
# =============================================================================

# REQUIRED ====================================================================
CLAUDE_CODE_OAUTH_TOKEN=your-claude-oauth-token

# PORT ========================================================================
PORT=3000

# OPTIONAL (for lending data) =================================================
DUNE_API_KEY=your-dune-api-key

# SECURITY (change in production) =============================================
API_KEY=change-this-in-production
BACKEND_API_KEY=change-this-in-production
POSTGRES_PASSWORD=password

# TRACKED ASSETS ==============================================================
TRACKED_ASSETS=BTC,ETH,SOL,BNB,XRP,ADA,LINK
TRACKED_FUTURES_ASSETS=BTC,ETH,SOL,BNB,XRP,ADA,LINK
TRACKED_LENDING_ASSETS=WETH,WBTC,USDC,USDT,DAI

# ADVANCED (defaults work fine) ===============================================
# LOG_LEVEL=INFO
# AGENT_TIMEOUT_SECONDS=600
# AGENT_MAX_TOOL_CALLS=30
# MAX_WORKERS=10
